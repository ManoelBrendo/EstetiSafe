# URL do backend (sem barra no final)
# Em produção comercial, use HTTPS. Exemplo: https://api.lappui.com
VITE_API_URL=https://lappui-backend.onrender.com

# Para desenvolvimento local no navegador:
# VITE_API_URL=http://localhost:3000

# No Android Emulator, o app converte localhost para 10.0.2.2 automaticamente.

# Contatos publicados na área de login e na aba Contatar suporte
VITE_SUPPORT_NAME=Seu nome ou equipe de suporte
VITE_SUPPORT_EMAIL=suporte@lappui.com
VITE_SUPPORT_PHONE=5511999999999

# Branding opcional da landing de captação
# Também pode ser sobrescrito por URL, por exemplo:
# ?brandName=Clinica%20Aurora&brandTagline=Estetica%20avancada&brandLogo=https://.../logo.png
VITE_MARKETING_BRAND_NAME=L'Appui
VITE_MARKETING_BRAND_TAGLINE=Software para clínicas de estética
VITE_MARKETING_BRAND_LOGO=
VITE_MARKETING_CLINIC_LABEL=Acompanhamento sanitário com clareza operacional
VITE_MARKETING_POWERED_BY=Powered by L'Appui