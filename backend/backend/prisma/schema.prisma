// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  hashedPassword     String
  clinicName         String
  clinicLogoDataUrl  String?  @db.Text
  clinicOperationalScopes String[] @default([])
  role               Role     @default(ADMIN)
  billingStatus      BillingStatus @default(TRIAL)
  billingAmount      Decimal? @db.Decimal(10, 2)
  billingGraceEndsAt DateTime?
  billingLastPaidAt  DateTime?
  billingNextDueAt   DateTime?
  billingReference   String?
  billingNotes       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownedClinic    Clinic?
  auditLogs      AuditLog[] @relation("UserAuditLogs")
  auditCorrectiveActions     AuditCorrectiveAction[]
  auditCorrectiveAttachments AuditCorrectiveActionAttachment[]
  clients        Client[]
  appointments   Appointment[]
  services       Service[]
  professionals  Professional[]
  consentRecords ConsentRecord[]
  servicePops    ServicePop[]
  documents      ClinicDocument[]
  professionalDocuments ProfessionalDocument[]
  productItems   ProductItem[]
  equipmentItems EquipmentItem[]
  clinicBills    ClinicBill[]
  billingGatewayIntents BillingGatewayIntent[]
  whatsappConfig WhatsappClinicConfig?
  whatsappLogs   WhatsappLog[]
  clinicalIntercurrences ClinicalIntercurrence[]

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
}

enum ConsentStatus {
  PENDING
  SIGNED
  REVOKED
}

enum BillingStatus {
  TRIAL
  ACTIVE
  OVERDUE
  BLOCKED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MarketingLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ClinicDocumentCategory {
  LEGAL
  SANITARY
  CLIENTS
  WASTE
}

enum InventoryEntryMode {
  NEW
  EXISTING
}

enum ProfessionalContractType {
  CLT
  PJ
  AUTONOMA
  COMISSIONADA
  PARCERIA
}

enum ProfessionalPaymentModel {
  FIXED
  COMMISSION
  HYBRID
  DAILY
}

enum ProfessionalDocumentCategory {
  CONTRACT
  CERTIFICATION
  COUNCIL
  TRAINING
  PERMISSION
}

// Leads and clients
model MarketingLead {
  id            Int                 @id @default(autoincrement())
  clinicName    String
  contactName   String
  email         String
  phone         String
  city          String?
  teamSize      String?
  mainGoal      String?
  message       String?
  requestedDemo Boolean             @default(true)
  source        String?
  status        MarketingLeadStatus @default(NEW)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("marketing_leads")
}

model Clinic {
  id          Int          @id @default(autoincrement())
  ownerUserId Int          @unique
  name        String
  logoDataUrl String?      @db.Text
  status      ClinicStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ownerUser    User                @relation(fields: [ownerUserId], references: [id])
  subscription ClinicSubscription?
  auditLogs    AuditLog[]
  billingGatewayIntents BillingGatewayIntent[]
  billingGatewayEvents BillingGatewayEvent[]

  @@index([status, createdAt])
  @@map("clinics")
}

model ClinicSubscription {
  id          Int           @id @default(autoincrement())
  clinicId    Int           @unique
  status      BillingStatus @default(TRIAL)
  amount      Decimal?      @db.Decimal(10, 2)
  graceEndsAt DateTime?
  lastPaidAt  DateTime?
  nextDueAt   DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([status, nextDueAt])
  @@map("clinic_subscriptions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  clinicId    Int?
  actorUserId Int?
  actorEmail  String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  clinic    Clinic? @relation(fields: [clinicId], references: [id])
  actorUser User?   @relation("UserAuditLogs", fields: [actorUserId], references: [id])

  @@index([clinicId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

enum AuditCorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
}

model AuditCorrectiveAction {
  id          Int                         @id @default(autoincrement())
  userId      Int
  taskKey     String
  domainId    String
  domainTitle String
  title       String
  owner       String
  dueLabel    String?
  dueAt       DateTime?
  evidence    String?                     @db.Text
  actionUrl   String?
  riskLevel   String
  status      AuditCorrectiveActionStatus @default(OPEN)
  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  user        User                              @relation(fields: [userId], references: [id])
  attachments AuditCorrectiveActionAttachment[]

  @@unique([userId, taskKey])
  @@index([userId, status])
  @@index([userId, domainId])
  @@map("audit_corrective_actions")
}

model AuditCorrectiveActionAttachment {
  id           Int      @id @default(autoincrement())
  userId       Int
  actionId     Int
  fileName     String
  fileMimeType String?
  fileDataUrl  String   @db.Text
  notes        String?
  createdAt    DateTime @default(now())

  user   User                  @relation(fields: [userId], references: [id])
  action AuditCorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([userId, actionId, createdAt])
  @@map("audit_corrective_action_attachments")
}

model Client {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  email     String?
  phone     String
  birthDate DateTime?
  cpf       String?
  photoDataUrl String?   @db.Text
  sex       String?
  maritalStatus String?
  profession String?
  addressFull String?
  notes     String?
  isPaid    Boolean  @default(false)
  isLocked  Boolean  @default(false)
  lockedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user           User            @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  anamneses      Anamnesis[]
  consentRecords ConsentRecord[]
  clinicalIntercurrences ClinicalIntercurrence[]
  facialPoints   FacialPoint[]

  @@index([userId])
  @@index([email])
  @@index([cpf])
  @@index([phone])
  @@map("clients")
}

model FacialPoint {
  id        Int      @id @default(autoincrement())
  clientId  Int
  pointId   String
  x         Float
  y         Float
  type      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("facial_points")
}

// Professionals
model Professional {
  id              Int                      @id @default(autoincrement())
  userId          Int
  name            String
  specialty       String
  phone           String?
  notes           String?
  photoDataUrl    String?                 @db.Text
  availability    Json?
  contractType    ProfessionalContractType?
  paymentModel    ProfessionalPaymentModel?
  salaryAmount    Decimal?                @db.Decimal(10, 2)
  commissionRate  Decimal?                @db.Decimal(5, 2)
  payrollBonusAmount Decimal?             @db.Decimal(10, 2)
  payrollDiscountAmount Decimal?          @db.Decimal(10, 2)
  paymentDay      Int?
  payrollNotes    String?
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  consentRecords ConsentRecord[]
  clinicalIntercurrences ClinicalIntercurrence[]
  documents      ProfessionalDocument[]

  @@index([userId])
  @@map("professionals")
}

model ProfessionalDocument {
  id             Int                          @id @default(autoincrement())
  userId         Int
  professionalId Int
  category       ProfessionalDocumentCategory
  documentType   String
  title          String
  notes          String?
  expiresAt      DateTime?
  fileName       String
  fileMimeType   String?
  fileDataUrl    String                       @db.Text
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([userId, professionalId, category])
  @@index([userId, expiresAt])
  @@map("professional_documents")
}

model Service {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  duration    Int      // duration in minutes
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  servicePop   ServicePop?
  clinicalIntercurrences ClinicalIntercurrence[]

  @@index([userId])
  @@map("services")
}

// Appointments
model Appointment {
  id             Int               @id @default(autoincrement())
  userId         Int
  clientId       Int
  serviceId      Int
  professionalId Int
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  price          Decimal           @db.Decimal(10, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  payment      Payment?
  whatsappLogs WhatsappLog[]

  @@index([userId, startAt, endAt])
  @@index([userId, professionalId, startAt])
  @@index([clientId])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Payments
model Payment {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

// Anamnesis
model Anamnesis {
  id          Int      @id @default(autoincrement())
  clientId    Int
  answers     Json     // form answers in JSON
  filledAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("anamneses")
}

model ConsentRecord {
  id               Int           @id @default(autoincrement())
  userId           Int
  clientId         Int
  professionalId   Int?
  title            String
  versionLabel     String        @default("v1")
  termText         String        @db.Text
  status           ConsentStatus @default(PENDING)
  signerName       String?
  signerDocument   String?
  professionalName String?
  signatureDataUrl String?      @db.Text
  signatureHash    String?
  signedAt         DateTime?
  signedIp         String?
  signedUserAgent  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  whatsappLogs WhatsappLog[]

  @@index([userId, clientId])
  @@index([clientId, createdAt])
  @@index([professionalId])
  @@map("consent_records")
}

model ClinicalIntercurrence {
  id                 Int      @id @default(autoincrement())
  userId             Int
  clientId           Int
  serviceId          Int?
  professionalId     Int?
  procedureName      String
  occurredAt         DateTime
  description        String   @db.Text
  conduct            String   @db.Text
  notes              String?  @db.Text
  professionalName   String
  createdByUserId    Int?
  createdByEmail     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  edits        ClinicalIntercurrenceEdit[]

  @@index([userId, occurredAt])
  @@index([userId, clientId, occurredAt])
  @@index([userId, professionalId, occurredAt])
  @@index([userId, serviceId, occurredAt])
  @@map("clinical_intercurrences")
}

model ClinicalIntercurrenceEdit {
  id               Int      @id @default(autoincrement())
  intercurrenceId  Int
  editedByUserId   Int?
  editedByEmail    String?
  editReason       String?
  changes          Json
  snapshotBefore   Json?
  snapshotAfter    Json?
  createdAt        DateTime @default(now())

  intercurrence ClinicalIntercurrence @relation(fields: [intercurrenceId], references: [id])

  @@index([intercurrenceId, createdAt])
  @@map("clinical_intercurrence_edits")
}

model ServicePop {
  id        Int      @id @default(autoincrement())
  userId    Int
  serviceId Int      @unique
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([userId, createdAt])
  @@map("service_pops")
}

model ClinicDocument {
  id           Int                   @id @default(autoincrement())
  userId       Int
  category     ClinicDocumentCategory
  documentType String
  title        String
  notes        String?
  expiresAt    DateTime?
  fileName     String
  fileMimeType String?
  fileDataUrl  String                @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, category, createdAt])
  @@index([userId, expiresAt])
  @@map("clinic_documents")
}

model ProductItem {
  id         Int                @id @default(autoincrement())
  userId     Int
  name       String
  category   String?
  brand      String?
  batch      String?
  quantity   Int                @default(1)
  unit       String?
  entryMode  InventoryEntryMode @default(NEW)
  purchasedAt DateTime?
  expiresAt  DateTime?
  notes      String?
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([userId, createdAt])
  @@map("product_items")
}

model EquipmentItem {
  id              Int                @id @default(autoincrement())
  userId          Int
  name            String
  category        String?
  brand           String?
  model           String?
  serialNumber    String?
  anvisaRegistration String?
  notificationNumber String?
  processNumber   String?
  entryMode       InventoryEntryMode @default(NEW)
  acquiredAt      DateTime?
  maintenanceDueAt DateTime?
  warrantyUntil   DateTime?
  notes           String?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, maintenanceDueAt])
  @@index([userId, createdAt])
  @@map("equipment_items")
}

model ClinicBill {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String
  category   String?
  amount     Decimal  @db.Decimal(10, 2)
  dueAt      DateTime
  paidAt     DateTime?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, dueAt])
  @@index([userId, paidAt])
  @@map("clinic_bills")
}


enum BillingGatewayIntentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum BillingGatewayMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
}

model BillingGatewayIntent {
  id                Int                        @id @default(autoincrement())
  clinicId          Int
  userId            Int
  reference         String                     @unique
  provider          String
  providerPaymentId String?
  method            BillingGatewayMethod
  status            BillingGatewayIntentStatus @default(PENDING)
  amount            Decimal                    @db.Decimal(10, 2)
  currency          String                     @default("BRL")
  dueAt             DateTime?
  expiresAt         DateTime?
  paidAt            DateTime?
  checkoutUrl       String?                    @db.Text
  pixCopyPaste      String?                    @db.Text
  payload           Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  events BillingGatewayEvent[]

  @@index([clinicId, createdAt])
  @@index([userId, status])
  @@index([status, dueAt])
  @@map("billing_gateway_intents")
}

model BillingGatewayEvent {
  id          Int                         @id @default(autoincrement())
  intentId    Int?
  clinicId    Int?
  reference   String?
  provider    String?
  eventType   String
  status      BillingGatewayIntentStatus?
  payload     Json?
  processedAt DateTime                    @default(now())

  intent BillingGatewayIntent? @relation(fields: [intentId], references: [id])
  clinic Clinic?               @relation(fields: [clinicId], references: [id])

  @@index([intentId, processedAt])
  @@index([clinicId, processedAt])
  @@index([reference])
  @@map("billing_gateway_events")
}

enum WhatsappMessageDirection {
  OUTBOUND
  INBOUND
  STATUS
}

enum WhatsappMessageType {
  TEMPLATE
  TEXT
  INTERACTIVE
  STATUS
  WEBHOOK
}

enum WhatsappMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
  CONFIRMED
  DECLINED
}

model WhatsappClinicConfig {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique
  phoneNumberId           String
  businessAccountId       String?
  accessTokenEncrypted    String   @db.Text
  verifyToken             String
  defaultLanguage         String   @default("pt_BR")
  appointmentTemplateName String   @default("appointment_confirmation")
  consentTemplateName     String   @default("consent_link")
  graphApiVersion         String   @default("v21.0")
  active                  Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  logs WhatsappLog[]

  @@index([phoneNumberId])
  @@index([active, createdAt])
  @@map("whatsapp_clinic_configs")
}

model WhatsappLog {
  id                Int                       @id @default(autoincrement())
  userId            Int
  configId          Int?
  appointmentId     Int?
  consentRecordId   Int?
  direction         WhatsappMessageDirection
  messageType       WhatsappMessageType
  providerMessageId String?
  recipientPhone    String?
  senderPhone       String?
  templateName      String?
  status            WhatsappMessageStatus?
  payload           Json?
  errorCode         String?
  errorMessage      String?
  receivedText      String?                   @db.Text
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  user          User                  @relation(fields: [userId], references: [id])
  config        WhatsappClinicConfig? @relation(fields: [configId], references: [id])
  appointment   Appointment?          @relation(fields: [appointmentId], references: [id])
  consentRecord ConsentRecord?        @relation(fields: [consentRecordId], references: [id])

  @@index([userId, createdAt])
  @@index([configId, createdAt])
  @@index([appointmentId])
  @@index([consentRecordId])
  @@index([providerMessageId])
  @@map("whatsapp_logs")
}
