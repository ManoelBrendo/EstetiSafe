# Server
PORT=3000

# PostgreSQL database
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/lappui"

# Production database examples: Render DB, Supabase, Neon
# DATABASE_URL="postgresql://..."

# JWT authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# CORS
# Separate multiple origins with commas.
# Local browser dev uses 5173; preview builds often use 4173.
FRONTEND_URL=http://localhost:5173,http://localhost:4173,http://10.0.2.2:4173

# Technical support access for maintenance across clinics
SUPPORT_ADMIN_EMAIL=suporte@lappui.com
SUPPORT_ADMIN_PASSWORD=defina_uma_senha_forte
SUPPORT_ADMIN_NAME=Central de suporte

# Published contacts in the support area
SUPPORT_CONTACT_NAME=Seu nome ou equipe de suporte
SUPPORT_CONTACT_EMAIL=suporte@lappui.com
SUPPORT_CONTACT_PHONE=5511999999999

# WhatsApp Business Platform
WHATSAPP_VERIFY_TOKEN="change-me"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me"
WHATSAPP_APP_SECRET="meta-app-secret"
WHATSAPP_GRAPH_API_VERSION="v21.0"
WHATSAPP_CONFIRMATION_JOB_ENABLED="false"
WHATSAPP_CONFIRMATION_JOB_INTERVAL_MS="900000"

# Financial gateway
# Initial phase uses provider-agnostic mode. Set the real provider when Pix/card integration is added.
BILLING_GATEWAY_PROVIDER="manual-ready"
BILLING_WEBHOOK_SECRET="troque_por_um_segredo_de_webhook_financeiro"
# Automatic subscription billing
# Enabled by default in the backend. Set false to pause generation of automatic charge intents.
BILLING_AUTO_CHARGE_ENABLED="true"
BILLING_AUTO_METHOD="PIX"
BILLING_AUTO_LOOKAHEAD_DAYS="3"
BILLING_AUTO_CHARGE_INTERVAL_MINUTES="60"
BILLING_AUTO_CHARGE_INITIAL_DELAY_MS="30000"
BILLING_AUTO_BATCH_LIMIT="50"
