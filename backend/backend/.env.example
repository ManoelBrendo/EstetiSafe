# Servidor
PORT=3000

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/lappui"

# Produção (Render DB / Supabase / Neon)
# DATABASE_URL="postgresql://..."

# Autenticação JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# CORS
# Separe múltiplas origens por vírgula.
# Em desenvolvimento local, inclua host web e Android Emulator.
FRONTEND_URL=http://localhost:4173,http://10.0.2.2:4173

# Acesso técnico para manutenção entre clínicas
SUPPORT_ADMIN_EMAIL=suporte@lappui.com
SUPPORT_ADMIN_PASSWORD=defina_uma_senha_forte
SUPPORT_ADMIN_NAME=Central de suporte

# Contatos publicados na aba "Contatar suporte"
SUPPORT_CONTACT_NAME=Seu nome ou equipe de suporte
SUPPORT_CONTACT_EMAIL=suporte@lappui.com
SUPPORT_CONTACT_PHONE=5511999999999
