{
  "name": "lappui-future-api-blueprint",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint isolado da futura API completa do L'Appui baseada no schema Prisma de prontuario.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "lint": "eslint src --ext js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0"
  }
}
